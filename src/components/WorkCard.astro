---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  index?: number;
}

const { entry, index } = Astro.props;
const { title, deck, year, tags, metrics, status, cover, coverAlt, projectUrl } = entry.data;
const planned = status === 'planned';
const destination = projectUrl ?? `/work/${entry.id}/`;
const isExternal = projectUrl != null;
---

<article class:list={['work-card', { 'work-card--planned': planned }]}>
  {
    cover && (
      <div class="work-card__media">
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[480, 800, 1200]}
          sizes="(min-width: 62rem) 44vw, 92vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="work-card__body">
    <p class="work-card__meta label">
      {index != null && <span class="work-card__index">{String(index).padStart(2, '0')}</span>}
      <span>{year}</span>
      {planned && <span class="work-card__flag">Planned</span>}
    </p>

    <h3 class="work-card__title">
      {planned ? title : <a href={destination} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>{title}</a>}
    </h3>

    <p class="work-card__deck">{deck}</p>

    {
      metrics.length > 0 && (
        <dl class="work-card__metrics">
          {metrics.map((metric) => (
            <div>
              <dt class="label">{metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {
      tags.length > 0 && (
        <ul class="work-card__tags" aria-label="Technologies">
          {tags.map((tag) => (
            <li class="label">{tag}</li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-l);
    border-block-start: 2px solid var(--rule-strong);
  }

  @media (min-width: 62rem) {
    .work-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-l);
      align-items: start;
    }
  }

  .work-card__media {
    overflow: hidden;
    background: var(--bg-inset);
    border: 1px solid var(--rule);
  }

  .work-card__media img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 480ms var(--reveal-ease);
  }

  .work-card:hover .work-card__media img {
    transform: scale(1.03);
  }

  .work-card__body {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .work-card__meta {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
  }

  .work-card__index {
    font-family: var(--font-display);
    font-weight: 800;
    color: var(--accent);
  }

  .work-card__flag {
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 0 0.35rem;
  }

  .work-card__title {
    font-size: var(--step-3);
    font-stretch: 78%;
    text-transform: uppercase;
  }

  .work-card__title a {
    text-decoration: none;
  }

  /* Keeps the whole card clickable without nesting interactive elements. */
  .work-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .work-card__deck {
    max-width: var(--measure);
  }

  .work-card--planned {
    color: var(--fg-dim);
  }

  .work-card--planned .work-card__title {
    color: var(--fg-muted);
  }

  .work-card__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block-start: var(--space-s);
  }

  .work-card__metrics dd {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-stretch: 78%;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    margin: 0;
  }

  .work-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-xs);
  }

  .work-card__tags li {
    border: 1px solid var(--rule);
    padding: 0.1rem 0.45rem;
  }

  @media (max-width: 48rem) {
    .work-card {
      gap: var(--space-s);
      padding-block: var(--space-m);
    }

    .work-card__metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
      gap: var(--space-s);
    }

    .work-card__tags {
      gap: 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card__media img,
    .work-card:hover .work-card__media img {
      transition: none;
      transform: none;
    }
  }
</style>
