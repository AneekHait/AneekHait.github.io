---
import { nav, site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header surface surface--ink">
  <div class="shell site-header__inner">
    <a class="brand" href="/">
      <span class="brand__name">{site.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} class:list={['site-nav__link', { 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      {site.resume && <a class="site-nav__link" href={site.resume}>R&eacute;sum&eacute;</a>}
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-block-end: 1px solid var(--rule);
    /* Solid ink masthead. It scrolls over paper, cobalt and acid bands, so it
       cannot be translucent without one of them showing through illegibly. */
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 20;
    padding-inline: max(0rem, env(safe-area-inset-left));
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    flex-wrap: wrap;
    padding-block: 0.65rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    padding-block: 0.2rem;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-stretch: 76%;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: var(--fg);
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    flex-wrap: wrap;
  }

  .site-nav__link {
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
    color: var(--fg-muted);
    position: relative;
    padding: 0.35rem 0.2rem;
    display: inline-flex;
    align-items: center;
    min-height: 2.2rem;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--accent);
  }

  .site-nav__link.is-active::after {
    content: '';
    position: absolute;
    inset-inline: 0.2rem;
    bottom: 0.1rem;
    height: 2px;
    background: var(--accent);
  }

  @media (max-width: 36rem) {
    .site-header__inner {
      gap: 0.4rem 0.75rem;
      padding-block: 0.55rem;
    }

    .site-nav {
      gap: 0.55rem;
    }

    .site-nav__link {
      padding: 0.25rem 0.35rem;
      font-size: 0.85rem;
    }
  }
</style>
