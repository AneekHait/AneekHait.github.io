---
interface Props {
  index: string;
  title: string;
  lead?: string;
  id?: string;
}

const { index, title, lead, id } = Astro.props;
const headingId = `${id ?? index.replace(/\W+/g, '')}-title`;
---

<section class="ledger" id={id} aria-labelledby={headingId}>
  <div class="shell ledger__inner">
    <p class="ledger__index mono">{index}</p>
    <div class="ledger__body">
      <header class="ledger__head">
        <h2 id={headingId}>{title}</h2>
        {lead && <p class="ledger__lead">{lead}</p>}
      </header>
      <slot />
    </div>
  </div>
</section>

<style>
  .ledger {
    border-block-start: 1px solid var(--rule);
    padding-block: var(--space-xl);
  }

  .ledger__inner {
    display: grid;
    grid-template-columns: var(--ledger-index) minmax(0, 1fr);
    gap: var(--space-m);
  }

  .ledger__index {
    color: var(--accent);
    padding-block-start: 0.5rem;
  }

  .ledger__head {
    max-width: var(--measure);
    margin-block-end: var(--space-l);
  }

  .ledger__head h2 {
    font-size: var(--step-3);
  }

  .ledger__lead {
    margin-block-start: var(--space-xs);
    font-size: var(--step-1);
    color: var(--fg-muted);
  }

  @media (max-width: 48rem) {
    .ledger {
      padding-block: var(--space-l);
    }

    .ledger__inner {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }

    .ledger__index {
      padding-block-start: 0;
    }
  }
</style>
