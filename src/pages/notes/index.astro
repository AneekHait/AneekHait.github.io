---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LedgerSection from '../../components/LedgerSection.astro';
import NoteCard from '../../components/NoteCard.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Notes"
  description="Short working notes on statistics, business intelligence, and analytical method by Aneek Hait."
>
  <LedgerSection
    index="Notes"
    title="Working notes."
    lead="Deliberately low-frequency. Published when there is something worth writing down, not on a schedule."
  >
    {notes.map((entry) => <NoteCard entry={entry} />)}
    <p class="feed"><a class="mono" href="/rss.xml">Subscribe via RSS →</a></p>
  </LedgerSection>
</BaseLayout>

<style>
  .feed {
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }

  .feed a {
    text-decoration: none;
  }
</style>
