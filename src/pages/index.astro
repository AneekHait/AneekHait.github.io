---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Surface from '../components/Surface.astro';
import WorkCard from '../components/WorkCard.astro';
import NoteCard from '../components/NoteCard.astro';
import portrait from '../assets/images/contact-aneek.webp';
import { site } from '../data/site';
import { experience } from '../data/experience';
import { toolkit } from '../data/toolkit';

const work = (await getCollection('work', ({ data }) => !data.draft && data.status === 'shipped')).sort(
  (a, b) => a.data.order - b.data.order,
);

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout title="Home">
  <Surface tone="ink" class="hero">
    <p class="hero__eyebrow label">
      <span>{site.role}</span>
      <span aria-hidden="true">/</span>
      <span>{site.location}</span>
    </p>

    <div class="hero__grid">
      <div class="hero__lede">
        <h1 id="hero-title" class="poster hero__name">Aneek<br />Hait</h1>
        <p class="hero__tagline">{site.tagline}</p>
      </div>

      <figure class="portrait">
        <Image
          src={portrait}
          alt="Aneek Hait"
          widths={[400, 640, 900]}
          sizes="(min-width: 62rem) 30vw, 68vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>

    <div class="hero__foot">
      <div class="hero__prose">
        <p>
          Officially: Data &amp; BI Analyst at Accenture in Kolkata. In practice it&rsquo;s about half
          analysis and half building the thing that makes the analysis possible &mdash; waiting two
          sprints for a script is how a question goes stale.
        </p>
        <div class="actions">
          <a class="button button--primary" href="/work">Selected work</a>
          <a class="button" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="button" href={site.socials.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <p class="hero__pull">
        I let a model write the first draft of a lot of that code. It doesn&rsquo;t get to merge
        itself.
      </p>
    </div>
  </Surface>

  <Surface tone="cobalt" size="tight" class="now">
    <p class="label now__label">Now</p>
    <p class="now__body">{site.now}</p>
  </Surface>

  <Surface tone="paper" id="work">
    <header class="sec-head">
      <p class="sec-head__index label">01 &mdash; Work</p>
      <h2 class="sec-head__title">Things I built because they bugged me.</h2>
      <p class="sec-head__lead">
        Both of these started as something I needed, couldn&rsquo;t find, and decided to write
        instead. Every figure comes from the repo it links to.
      </p>
    </header>

    {work.map((entry, i) => <WorkCard entry={entry} index={i + 1} />)}

    <p class="more"><a class="label" href="/work">All work &rarr;</a></p>
  </Surface>

  <Surface tone="ink" id="experience">
    <header class="sec-head">
      <p class="sec-head__index label">02 &mdash; Experience</p>
      <h2 class="sec-head__title">How I ended up here.</h2>
      <p class="sec-head__lead">
        Started in delivery, moved toward the decision. The build instinct never went away.
      </p>
    </header>

    <ol class="roles">
      {
        experience.map((role) => (
          <li class="role">
            <p class="role__period label">{role.period}</p>
            <div>
              <h3 class="role__title">
                {role.title}
                {role.qualifier && <span class="role__qualifier"> ({role.qualifier})</span>}
              </h3>
              <p class="role__org label">{role.org}</p>
              <ul class="role__points">
                {role.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </Surface>

  <Surface tone="acid" id="toolkit">
    <header class="sec-head">
      <p class="sec-head__index label">03 &mdash; Toolkit</p>
      <h2 class="sec-head__title">What&rsquo;s on the desk.</h2>
      <p class="sec-head__lead">
        Grouped by what I&rsquo;m doing rather than by vendor, because the question picks the tool.
      </p>
    </header>

    <div class="toolkit">
      {
        toolkit.map((group) => (
          <section class="toolkit__group">
            <h3 class="toolkit__label">{group.label}</h3>
            <ul class="toolkit__items">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Surface>

  <Surface tone="paper" id="notes">
    <header class="sec-head">
      <p class="sec-head__index label">04 &mdash; Notes</p>
      <h2 class="sec-head__title">Things I got tired of explaining twice.</h2>
      <p class="sec-head__lead">Short pieces on the statistics and habits behind the analysis.</p>
    </header>

    {notes.map((entry) => <NoteCard entry={entry} />)}

    <p class="more"><a class="label" href="/notes">All notes &rarr;</a></p>
  </Surface>

  <Surface tone="cobalt" size="tall" id="contact">
    <p class="sec-head__index label">05 &mdash; Contact</p>
    <h2 class="contact__title poster">Bring me<br />the messy one.</h2>
    <p class="contact__lead">
      Fuzzy question, dubious data, no obvious owner. I&rsquo;m interested in analysis, BI, and
      reporting work where an analyst is allowed to build the tooling as well as read the output.
    </p>
    <div class="actions">
      <a class="button button--primary" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">
        Connect on LinkedIn
      </a>
      <a class="button" href={site.socials.github} target="_blank" rel="noopener noreferrer">
        Browse the code
      </a>
      {site.resume && <a class="button" href={site.resume}>Download r&eacute;sum&eacute;</a>}
    </div>
  </Surface>
</BaseLayout>

<style>
  /* Hero ----------------------------------------------------------------- */

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-block-end: var(--space-s);
    border-block-end: 1px solid var(--rule);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-l);
    align-items: end;
    padding-block-start: var(--space-s);
  }

  .hero__lede {
    display: grid;
    gap: var(--space-s);
  }

  .hero__name {
    margin: 0;
    text-transform: uppercase;
  }

  .portrait {
    position: relative;
    margin: 0;
    max-width: 20rem;
    isolation: isolate;
  }

  /* A hard offset block behind the portrait: the only ornament on the page. */
  .portrait::before {
    content: '';
    position: absolute;
    inset: 1.1rem -1.1rem -1.1rem 1.1rem;
    background: var(--cobalt);
    z-index: -1;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__foot {
    display: grid;
    gap: var(--space-m);
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-s);
    border-block-start: 2px solid var(--rule-strong);
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-stretch: 82%;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--fg);
    margin: 0;
    text-wrap: balance;
  }

  .hero__prose {
    display: grid;
    gap: var(--space-s);
    max-width: var(--measure);
  }

  .hero__pull {
    padding-inline-start: var(--space-s);
    border-inline-start: 3px solid var(--accent);
    color: var(--fg);
    font-size: var(--step-1);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-xs);
  }

  /* Now ------------------------------------------------------------------ */

  .now__label {
    margin-block-end: var(--space-xs);
  }

  .now__body {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-stretch: 84%;
    font-weight: 600;
    line-height: 1.16;
    color: var(--fg);
    max-width: 48ch;
    text-wrap: pretty;
  }

  /* Section heads -------------------------------------------------------- */

  .sec-head {
    display: grid;
    gap: var(--space-xs);
    margin-block-end: var(--space-l);
  }

  .sec-head__index {
    color: var(--accent);
  }

  .sec-head__title {
    font-size: var(--step-4);
    font-stretch: 74%;
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    max-width: 18ch;
  }

  .sec-head__lead {
    font-size: var(--step-1);
    max-width: var(--measure);
    text-wrap: pretty;
  }

  .more {
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-s);
    border-block-start: 2px solid var(--rule-strong);
  }

  .more a {
    text-decoration: none;
  }

  /* Experience ----------------------------------------------------------- */

  .roles {
    list-style: none;
    padding: 0;
    display: grid;
  }

  .role {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-m);
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--rule);
  }

  .role__period {
    color: var(--fg-dim);
  }

  .role__title {
    font-size: var(--step-1);
    font-stretch: 88%;
  }

  .role__qualifier {
    color: var(--fg-dim);
    font-weight: 400;
  }

  .role__org {
    margin-block-start: 0.15rem;
    color: var(--accent);
  }

  .role__points {
    margin-block-start: var(--space-xs);
    display: grid;
    gap: 0.35rem;
    max-width: var(--measure);
    list-style: none;
    padding-inline-start: 0;
  }

  .role__points li {
    position: relative;
    padding-inline-start: 1.1rem;
  }

  .role__points li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
  }

  /* Toolkit -------------------------------------------------------------- */

  .toolkit {
    display: grid;
    gap: var(--space-l);
  }

  .toolkit__group {
    border-block-start: 2px solid var(--rule-strong);
    padding-block-start: var(--space-xs);
  }

  .toolkit__label {
    font-size: var(--step-1);
    font-stretch: 80%;
    text-transform: uppercase;
    margin-block-end: var(--space-xs);
  }

  .toolkit__items {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .toolkit__items li {
    border: 1px solid var(--rule-strong);
    padding: 0.2rem 0.55rem;
    font-size: var(--step--1);
    color: var(--fg);
    background: rgba(0, 0, 0, 0.03);
  }

  /* Contact -------------------------------------------------------------- */

  .contact__title {
    font-size: var(--step-5);
    text-transform: uppercase;
    margin-block: var(--space-s) var(--space-m);
  }

  .contact__lead {
    font-size: var(--step-1);
    max-width: var(--measure);
    margin-block-end: var(--space-m);
  }

  @media (min-width: 48rem) {
    .toolkit {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 62rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-xl);
    }

    /* The name only fills part of its column, so the tagline sits in the leftover. */
    .hero__lede {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      gap: var(--space-l);
    }

    .hero__foot {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  @media (min-width: 72rem) {
    .toolkit {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-m);
    }
  }

  @media (max-width: 62rem) {
    .role {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }

    .portrait {
      max-width: 13rem;
    }
  }

  @media (max-width: 48rem) {
    .hero__grid {
      gap: var(--space-m);
    }

    .portrait {
      max-width: 9.5rem;
      margin-block-start: var(--space-xs);
    }

    .portrait::before {
      inset: 0.55rem -0.55rem -0.55rem 0.55rem;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-xs);
    }

    .actions .button {
      flex: 1 1 calc(50% - var(--space-xs));
      text-align: center;
    }

    .actions .button--primary {
      flex-basis: 100%;
    }
  }
</style>
