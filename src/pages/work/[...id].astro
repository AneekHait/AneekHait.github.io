---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Surface from '../../components/Surface.astro';
import Metric from '../../components/Metric.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft && data.status === 'shipped');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'work'> };

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, deck, year, role, tags, metrics, repoUrl, demoUrl, cover, coverAlt } = entry.data;
---

<BaseLayout title={title} description={deck}>
  <article class="case">
    <Surface tone="ink" as="header" size="tall" class="case__head">
      <p class="case__meta label">
        <a href="/work">Work</a>
        <span aria-hidden="true">/</span>
        <span>{year}</span>
      </p>
      <h1 class="page-head__title">{title}</h1>
      <p class="case__deck">{deck}</p>

      <dl class="case__facts">
        <div>
          <dt class="label">Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt class="label">Stack</dt>
          <dd>{tags.join(' · ')}</dd>
        </div>
      </dl>

      {
        (repoUrl || demoUrl) && (
          <div class="case__links">
            {demoUrl && (
              <a class="button button--primary" href={demoUrl} target="_blank" rel="noopener noreferrer">
                Open dashboard
              </a>
            )}
            {repoUrl && (
              <a class="button" href={repoUrl} target="_blank" rel="noopener noreferrer">
                Repository
              </a>
            )}
          </div>
        )
      }
    </Surface>

    {
      metrics.length > 0 && (
        <Surface tone="cobalt" size="tight">
          <div class="case__metrics">
            {metrics.map((metric) => (
              <Metric value={metric.value} label={metric.label} />
            ))}
          </div>
        </Surface>
      )
    }

    <Surface tone="paper">
      {
        cover && (
          <figure class="case__cover">
            <Image src={cover} alt={coverAlt ?? ''} widths={[640, 1100, 1600]} sizes="(min-width: 76rem) 72rem, 100vw" loading="eager" />
          </figure>
        )
      }

      <div class="prose case__body"><Content /></div>

      <div class="case__foot">
        <a class="label" href="/work">← All work</a>
      </div>
    </Surface>
  </article>
</BaseLayout>

<style>
  .case__meta {
    display: flex;
    gap: 0.5rem;
    color: var(--accent);
  }

  .case__meta a {
    text-decoration: none;
  }

  .case__deck {
    font-size: var(--step-1);
    max-width: var(--measure);
  }

  .case__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }

  .case__facts dd {
    margin: 0;
    color: var(--fg);
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-m);
  }

  .case__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-m);
  }

  .case__cover {
    margin-block-end: var(--space-xl);
  }

  .case__cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--rule);
  }

  .case__foot {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-m);
    border-block-start: 2px solid var(--rule-strong);
  }

  .case__foot a {
    text-decoration: none;
  }
</style>
