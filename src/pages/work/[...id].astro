---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft && data.status === 'shipped');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'work'> };

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, deck, year, role, tags, metrics, repoUrl, demoUrl, cover, coverAlt } = entry.data;
---

<BaseLayout title={title} description={deck}>
  <article class="case">
    <header class="shell case__head">
      <p class="case__meta mono">
        <a href="/work">Work</a>
        <span aria-hidden="true">/</span>
        <span>{year}</span>
      </p>
      <h1>{title}</h1>
      <p class="case__deck">{deck}</p>

      <dl class="case__facts">
        <div>
          <dt class="mono">Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt class="mono">Stack</dt>
          <dd>{tags.join(' · ')}</dd>
        </div>
      </dl>

      {
        (repoUrl || demoUrl) && (
          <div class="case__links">
            {demoUrl && (
              <a class="button button--primary" href={demoUrl} target="_blank" rel="noopener noreferrer">
                Open dashboard
              </a>
            )}
            {repoUrl && (
              <a class="button" href={repoUrl} target="_blank" rel="noopener noreferrer">
                Repository
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      metrics.length > 0 && (
        <dl class="shell case__metrics">
          {metrics.map((metric) => (
            <div>
              <dd>{metric.value}</dd>
              <dt class="mono">{metric.label}</dt>
            </div>
          ))}
        </dl>
      )
    }

    {
      cover && (
        <figure class="shell case__cover">
          <Image src={cover} alt={coverAlt ?? ''} widths={[640, 1100, 1600]} sizes="(min-width: 76rem) 72rem, 100vw" loading="eager" />
        </figure>
      )
    }

    <div class="shell case__body">
      <div class="prose"><Content /></div>
    </div>

    <div class="shell case__foot">
      <a class="mono" href="/work">← All work</a>
    </div>
  </article>
</BaseLayout>

<style>
  .case__head {
    padding-block: var(--space-xl) var(--space-m);
  }

  .case__meta {
    display: flex;
    gap: 0.5rem;
    color: var(--accent);
  }

  .case__meta a {
    text-decoration: none;
  }

  .case__head h1 {
    font-size: var(--step-3);
    margin-block-start: var(--space-s);
  }

  .case__deck {
    font-size: var(--step-1);
    max-width: var(--measure);
    margin-block-start: var(--space-xs);
  }

  .case__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-m);
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }

  .case__facts dd {
    margin: 0;
    color: var(--fg);
  }

  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-block-start: var(--space-m);
  }

  .case__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    padding-block: var(--space-m);
    border-block: 1px solid var(--rule);
  }

  .case__metrics dd {
    margin: 0;
    color: var(--accent);
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1;
  }

  .case__metrics dt {
    margin-block-start: var(--space-2xs);
  }

  .case__cover {
    margin-block: var(--space-l);
  }

  .case__cover :global(img) {
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .case__body {
    padding-block-end: var(--space-xl);
  }

  .case__foot {
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--rule);
  }

  .case__foot a {
    text-decoration: none;
  }
</style>
